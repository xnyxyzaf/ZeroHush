<Window x:Class="PixelStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Settings_Title}" Icon="pack://application:,,,/logo.ico" Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme_WindowBg}"        
        Foreground="#E6E6E6"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="20,14">
            <TextBlock Text="{loc:Loc Key=Settings_Title}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ★ 左侧导航栏背景 -->
            <Border Grid.Column="0" Background="{DynamicResource Theme_WindowBg}" Padding="10,14">
                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Theme_TextSecondary}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="12,9">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_Border}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBoxItem Content="{loc:Loc Key=Settings_General}"/>
                    <ListBoxItem Content="{loc:Loc Key=Settings_Personalization}"/>
                    <ListBoxItem Content="{loc:Loc Key=Settings_Performance}"/>
                    <ListBoxItem Content="{loc:Loc Key=Settings_Shortcuts}"/>
                    <ListBoxItem Content="{loc:Loc Key=Settings_Plugins}"/>
                    <ListBoxItem Content="{loc:Loc Key=Settings_Thanks}"/>
                    <ListBoxItem Content="{loc:Loc Key=Settings_About}"/>
                </ListBox>
            </Border>

            <!-- ★ 右侧内容区背景 -->
            <Border Grid.Column="1" Background="{DynamicResource Theme_WindowBg}" Padding="30,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>

                        <!-- ========== 通用 ========== -->
                        <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_General}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc Key=Settings_Language}"
                                           Foreground="White" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="LanguageCombo"
                                          Grid.Column="1"
                                          Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="LanguageCombo_Changed"/>
                            </Grid>
                            <TextBlock Text="{loc:Loc Key=Settings_LanguageHint}"
                                       Foreground="{DynamicResource Theme_TextDim}" FontSize="11"
                                       Margin="0,0,0,24"
                                       TextWrapping="Wrap"/>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <CheckBox x:Name="DefaultShowGridCheck"
                                          Content="{loc:Loc Key=Settings_ShowGrid}"
                                          Foreground="White" FontSize="13"/>
                            </Border>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc Key=Settings_BrushSize}"
                                               Foreground="White" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="DefaultBrushSizeSlider"
                                                Minimum="1" Maximum="20" Value="1"
                                                Width="160"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                VerticalAlignment="Center"
                                                ValueChanged="DefaultBrushSize_Changed"/>
                                        <TextBlock x:Name="DefaultBrushSizeLabel"
                                                   Text="1" Foreground="{DynamicResource Theme_TextSecondary}"
                                                   FontSize="12" Width="36"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc Key=Settings_Opacity}"
                                               Foreground="White" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="DefaultOpacitySlider"
                                                Minimum="0" Maximum="100" Value="100"
                                                Width="160"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="5"
                                                VerticalAlignment="Center"
                                                ValueChanged="DefaultOpacity_Changed"/>
                                        <TextBlock x:Name="DefaultOpacityLabel"
                                                   Text="100%" Foreground="{DynamicResource Theme_TextSecondary}"
                                                   FontSize="12" Width="48"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ========== 个性化 ========== -->
                        <StackPanel x:Name="PanelPersonalization" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_Personalization}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="{loc:Loc Key=Theme_Title}"
                                       Foreground="White" FontSize="13"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Key=Theme_Hint}"
                                       Foreground="{DynamicResource Theme_TextDim}" FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <StackPanel x:Name="ThemeListPanel"/>

                            <TextBlock Text="{loc:Loc Key=Theme_Custom}"
                                       Foreground="White" FontSize="13"
                                       Margin="0,20,0,4"/>
                            <TextBlock Text="{loc:Loc Key=Theme_CustomHint}"
                                       Foreground="{DynamicResource Theme_TextDim}" FontSize="11"
                                       Margin="0,0,0,12"/>

                            <Border x:Name="CustomColorCard"
                                    Height="64"
                                    Width="480"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Theme_PanelBg}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource Theme_Border}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="CustomColorCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="CustomColorSwatch"
                                            Width="32" Height="32"
                                            CornerRadius="6"
                                            Background="#4A90E2"
                                            Margin="16,0,16,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Theme_Border}"
                                            BorderThickness="1"/>

                                    <TextBlock x:Name="CustomColorLabel"
                                               Grid.Column="1"
                                               Text="{loc:Loc Key=Theme_CustomPick}"
                                               Foreground="White"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="›"
                                               Foreground="{DynamicResource Theme_TextDim}"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ========== 性能 ========== -->
                        <StackPanel x:Name="PanelPerformance" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_Performance}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Settings_HistoryBudget}"
                                               Foreground="White" FontSize="13"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{loc:Loc Key=Settings_HistoryHint}"
                                               Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="HistoryBudgetSlider"
                                                Grid.Column="0"
                                                Minimum="50" Maximum="500" Value="200"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="50"
                                                VerticalAlignment="Center"
                                                ValueChanged="HistoryBudget_Changed"/>
                                        <TextBlock x:Name="HistoryBudgetLabel"
                                                   Grid.Column="1"
                                                   Text="200 MB" Foreground="{DynamicResource Theme_TextSecondary}"
                                                   FontSize="12" Width="70"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </Grid>

                                    <TextBlock x:Name="MemoryHintText"
                                               Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11"
                                               Margin="0,14,0,0"
                                               TextWrapping="Wrap"
                                               Text=""/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========== 快捷键 ========== -->
                        <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="{loc:Loc Key=Settings_Shortcuts}"
                                           Foreground="White" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Content="{loc:Loc Key=Shortcut_ResetAll}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="14,6"
                                        Background="{DynamicResource Theme_Border}" Foreground="White"
                                        BorderThickness="0" FontSize="11"
                                        Cursor="Hand"
                                        Click="ResetShortcuts_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <StackPanel x:Name="ShortcutListPanel"/>
                        </StackPanel>

                        <!-- ========== 插件 ========== -->
                        <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_Plugins}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="PluginCountLabel"
                                       Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="{loc:Loc Key=Plugins_Hint}"
                                       Foreground="{DynamicResource Theme_TextDim}" FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <Button Content="{loc:Loc Key=Plugins_Folder}"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="16,8"
                                    Background="{DynamicResource Theme_Border}" Foreground="White"
                                    BorderThickness="0" FontSize="12"
                                    Cursor="Hand"
                                    Margin="0,0,0,20"
                                    Click="OpenPluginsFolder_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel x:Name="PluginListPanel"/>
                        </StackPanel>

                        <!-- ========== 致谢 ========== -->
                        <StackPanel x:Name="PanelThanks" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_Thanks}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Settings_ThanksHint}"
                                               Foreground="{DynamicResource Theme_TextSecondary}" FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16"/>
                                    <Button Content="{loc:Loc Key=Settings_ViewThanks}"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="18,9"
                                            Background="{DynamicResource Theme_Accent}" Foreground="White"
                                            BorderThickness="0" FontSize="12"
                                            Cursor="Hand"
                                            Click="OpenThanks_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========== 关于 ========== -->
                        <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Key=Settings_About}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Settings_Version}"
                                               Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:Loc Key=Settings_Tagline}"
                                               Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"
                                               Margin="0,6,0,4"/>
                                    <TextBlock Text="{loc:Loc Key=Settings_BuiltWith}"
                                               Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Update_CheckNow}"
                                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>

                                    <CheckBox x:Name="AutoCheckUpdateCheck"
                                              Content="{loc:Loc Key=Update_AutoCheck}"
                                              Foreground="White" FontSize="13"
                                              Margin="0,0,0,14"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdateButton"
                                                Content="{loc:Loc Key=Update_CheckNow}"
                                                Height="32"
                                                Padding="16,0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="{DynamicResource Theme_Border}" Foreground="White"
                                                BorderThickness="0" FontSize="12"
                                                Cursor="Hand"
                                                Click="CheckUpdate_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_WindowBg}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme_TextDim}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <TextBlock x:Name="CheckUpdateResultText"
                                                   Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=About_Feedback}"
                                               Foreground="White" FontSize="14" FontWeight="SemiBold"/>

                                    <TextBlock Text="{loc:Loc Key=About_EmailHint}"
                                               Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,12"/>

                                    <Border Background="{DynamicResource Theme_WindowBg}"
                                            CornerRadius="6"
                                            Padding="14,10"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Key=About_EmailHint2}"
                                                       Foreground="{DynamicResource Theme_TextDim}"
                                                       FontSize="11"
                                                       Margin="0,0,0,8"
                                                       TextWrapping="Wrap"/>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="zeromubug_feedback@163.com"
                                                           Foreground="{DynamicResource Theme_Accent}"
                                                           FontSize="12"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Content="{loc:Loc Key=About_CopyEmail}"
                                                        Padding="10,5"
                                                        Margin="10,0,0,0"
                                                        Background="{DynamicResource Theme_Border}" Foreground="White"
                                                        BorderThickness="0" FontSize="11"
                                                        Cursor="Hand"
                                                        Tag="zeromubug_feedback@163.com"
                                                        Click="CopyEmail_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="zeromubug_feedback@outlook.com"
                                                           Foreground="{DynamicResource Theme_Accent}"
                                                           FontSize="12"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Content="{loc:Loc Key=About_CopyEmail}"
                                                        Padding="10,5"
                                                        Margin="10,0,0,0"
                                                        Background="{DynamicResource Theme_Border}" Foreground="White"
                                                        BorderThickness="0" FontSize="11"
                                                        Cursor="Hand"
                                                        Tag="zeromubug_feedback@outlook.com"
                                                        Click="CopyEmail_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="{loc:Loc Key=Feedback_Title}"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="16,8"
                                            Background="{DynamicResource Theme_Accent}" Foreground="White"
                                            BorderThickness="0" FontSize="12"
                                            Cursor="Hand"
                                            Click="OpenFeedback_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Common_Reset}" Width="90" Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource Theme_Border}" Foreground="White"
                        BorderThickness="0" FontSize="12"
                        Cursor="Hand"
                        Click="Reset_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="{loc:Loc Key=Common_Cancel}" Width="80" Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource Theme_Border}" Foreground="White"
                        BorderThickness="0" FontSize="12"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="{loc:Loc Key=Common_Save}" Width="80" Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource Theme_Accent}" Foreground="White"
                        BorderThickness="0" FontSize="12"
                        Cursor="Hand"
                        Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>