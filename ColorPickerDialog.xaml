<Window x:Class="PixelStudio.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Color_Title}" Icon="pack://application:,,,/logo.ico" Width="400" Height="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme_WindowBg}" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="220" CornerRadius="8" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Border x:Name="SvBase" CornerRadius="8"/>
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas x:Name="SvCanvas" Background="Transparent" MouseLeftButtonDown="SvCanvas_MouseDown" MouseMove="SvCanvas_MouseMove" MouseLeftButtonUp="SvCanvas_MouseUp">
                    <Ellipse x:Name="SvIndicator" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
                <Border x:Name="PreviewCircle" Background="Black" CornerRadius="20"/>
            </Border>

            <Border Grid.Column="1" Height="20" CornerRadius="10">
                <Grid>
                    <Border CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                <GradientStop Color="#00FF00" Offset="0.3333"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.6667"/>
                                <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="HueCanvas" Background="Transparent" MouseLeftButtonDown="HueCanvas_MouseDown" MouseMove="HueCanvas_MouseMove" MouseLeftButtonUp="HueCanvas_MouseUp">
                        <Ellipse x:Name="HueIndicator" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBox x:Name="RBox" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="10,8" FontFamily="Consolas" FontSize="14" TextAlignment="Center" TextChanged="RgbBox_TextChanged"/>
                <TextBlock Text="R" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBox x:Name="GBox" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="10,8" FontFamily="Consolas" FontSize="14" TextAlignment="Center" TextChanged="RgbBox_TextChanged"/>
                <TextBlock Text="G" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBox x:Name="BBox" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="10,8" FontFamily="Consolas" FontSize="14" TextAlignment="Center" TextChanged="RgbBox_TextChanged"/>
                <TextBlock Text="B" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc Key=Color_HexLabel}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
            <TextBox x:Name="HexBox" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="10,8" FontFamily="Consolas" FontSize="14" TextChanged="HexBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc Key=Common_Cancel}" Width="90" Height="34" Margin="0,0,8,0" Click="Cancel_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="{loc:Loc Key=Common_OK}" Width="90" Height="34" Click="Ok_Click" Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>