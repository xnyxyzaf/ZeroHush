<Window x:Class="PixelStudio.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Feedback_Title}" Icon="pack://application:,,,/logo.ico" Width="560" Height="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme_WindowBg}"
        Foreground="#E6E6E6" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">

	<Border Background="{DynamicResource Theme_WindowBg}" CornerRadius="12" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
		</Border.Effect>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseDown">
				<TextBlock Text="{loc:Loc Key=Feedback_Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
			</Border>

			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="20">
					<TextBlock Text="{loc:Loc Key=Feedback_Type}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
					<ComboBox x:Name="TypeCombo" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="8,6" FontSize="12" Margin="0,0,0,16">
						<ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Bug}" Tag="bug"/>
						<ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Ui}" Tag="ui"/>
						<ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Suggest}" Tag="suggest"/>
						<ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Other}" Tag="other"/>
					</ComboBox>

					<TextBlock Text="{loc:Loc Key=Feedback_Desc}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
					<TextBox x:Name="DescBox" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="10,8" FontSize="12" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

					<TextBlock Text="{loc:Loc Key=Feedback_SystemInfo}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
					<Border Background="{DynamicResource Theme_WindowBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
						<TextBlock x:Name="SystemInfoText" Foreground="{DynamicResource Theme_TextDim}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
					</Border>

					<TextBlock Text="{loc:Loc Key=Feedback_Note}" Foreground="{DynamicResource Theme_TextDim}" FontSize="11" TextWrapping="Wrap"/>
				</StackPanel>
			</ScrollViewer>

			<Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" CornerRadius="0,0,12,12" Padding="16,12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Orientation="Horizontal">
						<Button x:Name="CopyButton" Content="{loc:Loc Key=Feedback_CopyAll}" Height="32" Padding="14,0" Margin="0,0,8,0" Click="Copy_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
						<Button Content="{loc:Loc Key=Feedback_OpenGitHub}" Height="32" Padding="14,0" Click="OpenGitHub_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>

					<StackPanel Grid.Column="2" Orientation="Horizontal">
						<Button Content="{loc:Loc Key=Common_Cancel}" Width="80" Height="32" Margin="0,0,8,0" Click="Cancel_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
						<Button Content="{loc:Loc Key=Feedback_OpenMail}" Height="32" Padding="16,0" Click="OpenMail_Click" Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bg" Property="Opacity" Value="0.8"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>