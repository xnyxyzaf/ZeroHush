<Window x:Class="PixelStudio.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Feedback_Title}" Icon="pack://application:,,,/logo.ico"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
Background="{DynamicResource Theme_WindowBg}"        Foreground="#E6E6E6"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#1E1E1E"
            CornerRadius="12"
            BorderBrush="#3A3A3A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0"
                    Background="#262626"
                    CornerRadius="12,12,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="{loc:Loc Key=Feedback_Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <!-- 类型 -->
                    <TextBlock Text="{loc:Loc Key=Feedback_Type}"
                               Foreground="#9A9A9A" FontSize="12"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="TypeCombo"
                              Background="#2E2E2E"
                              Foreground="White"
                              BorderThickness="0"
                              Padding="8,6"
                              FontSize="12"
                              Margin="0,0,0,16">
                        <ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Bug}" Tag="bug"/>
                        <ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Ui}" Tag="ui"/>
                        <ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Suggest}" Tag="suggest"/>
                        <ComboBoxItem Content="{loc:Loc Key=Feedback_Type_Other}" Tag="other"/>
                    </ComboBox>

                    <!-- 描述 -->
                    <TextBlock Text="{loc:Loc Key=Feedback_Desc}"
                               Foreground="#9A9A9A" FontSize="12"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="DescBox"
                             Background="#2E2E2E"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10,8"
                             FontSize="12"
                             Height="140"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16"/>

                    <!-- 系统信息 -->
                    <TextBlock Text="{loc:Loc Key=Feedback_SystemInfo}"
                               Foreground="#9A9A9A" FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="#1A1A1A"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <TextBlock x:Name="SystemInfoText"
                                   Foreground="#7A7A7A"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- 提示 -->
                    <TextBlock Text="{loc:Loc Key=Feedback_Note}"
                               Foreground="#5A5A5A" FontSize="11"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <Border Grid.Row="2"
                    Background="#262626"
                    CornerRadius="0,0,12,12"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：复制 / GitHub -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="CopyButton"
                                Content="{loc:Loc Key=Feedback_CopyAll}"
                                Height="32"
                                Padding="14,0"
                                Margin="0,0,8,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#3A3A3A" Foreground="White"
                                BorderThickness="0" FontSize="12"
                                Cursor="Hand"
                                Click="Copy_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A4A4A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="{loc:Loc Key=Feedback_OpenGitHub}"
                                Height="32"
                                Padding="14,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#3A3A3A" Foreground="White"
                                BorderThickness="0" FontSize="12"
                                Cursor="Hand"
                                Click="OpenGitHub_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A4A4A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- 右：关闭 / 打开邮箱 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{loc:Loc Key=Common_Cancel}"
                                Width="80" Height="32"
                                Margin="0,0,8,0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#3A3A3A" Foreground="White"
                                BorderThickness="0" FontSize="12"
                                Cursor="Hand"
                                Click="Cancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#4A4A4A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="{loc:Loc Key=Feedback_OpenMail}"
                                Height="32"
                                Padding="16,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#4A90E2" Foreground="White"
                                BorderThickness="0" FontSize="12"
                                Cursor="Hand"
                                Click="OpenMail_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#5AA0F2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>