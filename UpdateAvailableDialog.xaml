<Window x:Class="PixelStudio.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Update_Title}"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E6E6E6"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#1E1E1E"
            CornerRadius="12"
            BorderBrush="#3A3A3A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="#262626"
                    CornerRadius="12,12,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="{loc:Loc Key=Update_Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">

                    <!-- 版本对比 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                        <Border Background="#2A2A2A"
                                CornerRadius="6"
                                Padding="12,6">
                            <TextBlock x:Name="CurrentVersionText"
                                       Foreground="#9A9A9A"
                                       FontSize="12"
                                       FontFamily="Consolas"/>
                        </Border>

                        <TextBlock Text="→"
                                   Foreground="#5A5A5A"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"/>

                        <Border Background="#1E3A5F"
                                CornerRadius="6"
                                Padding="12,6">
                            <TextBlock x:Name="LatestVersionText"
                                       Foreground="#4A90E2"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>

                    <!-- 更新说明 -->
                    <TextBlock Text="{loc:Loc Key=Update_Notes}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="#1A1A1A"
                            CornerRadius="6"
                            Padding="14,12">
                        <TextBlock x:Name="ReleaseNotesText"
                                   Foreground="#C8C8C8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <Border Grid.Row="2"
                    Background="#262626"
                    CornerRadius="0,0,12,12"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Key=Update_Skip}"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent" Foreground="#7A7A7A"
                            BorderThickness="0" FontSize="12"
                            Cursor="Hand"
                            Click="Skip_Click"/>

                    <Button Content="{loc:Loc Key=Update_Later}"
                            Width="80" Height="32"
                            Margin="0,0,8,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#3A3A3A" Foreground="White"
                            BorderThickness="0" FontSize="12"
                            Cursor="Hand"
                            Click="Later_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#4A4A4A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="{loc:Loc Key=Update_Download}"
                            Height="32"
                            Padding="16,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#4A90E2" Foreground="White"
                            BorderThickness="0" FontSize="12"
                            Cursor="Hand"
                            Click="Download_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#5AA0F2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>