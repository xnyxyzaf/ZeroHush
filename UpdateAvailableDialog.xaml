<Window x:Class="PixelStudio.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Update_Title}" Width="520" Height="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme_WindowBg}"
        Foreground="#E6E6E6" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">

	<Border Background="{DynamicResource Theme_WindowBg}" CornerRadius="12" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
		</Border.Effect>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseDown">
				<TextBlock Text="{loc:Loc Key=Update_Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
			</Border>

			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="24,20,24,20">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
						<Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="6" Padding="12,6">
							<TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" FontFamily="Consolas"/>
						</Border>
						<TextBlock Text="→" Foreground="{DynamicResource Theme_TextDim}" FontSize="16" VerticalAlignment="Center" Margin="12,0,12,0"/>
						<Border Background="{DynamicResource Theme_HoverBg}" CornerRadius="6" Padding="12,6">
							<TextBlock x:Name="LatestVersionText" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"/>
						</Border>
					</StackPanel>

					<TextBlock Text="{loc:Loc Key=Update_Notes}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
					<Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="6" Padding="14,12">
						<TextBlock x:Name="ReleaseNotesText" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" CornerRadius="0,0,12,12" Padding="16,12">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="{loc:Loc Key=Update_Skip}" Height="32" Padding="14,0" Margin="0,0,8,0" Click="Skip_Click" Background="Transparent" Foreground="{DynamicResource Theme_TextDim}" BorderThickness="0" FontSize="12" Cursor="Hand"/>
					<Button Content="{loc:Loc Key=Update_Later}" Width="80" Height="32" Margin="0,0,8,0" Click="Later_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<Button Content="{loc:Loc Key=Update_Download}" Height="32" Padding="16,0" Click="Download_Click" Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="bg" Property="Opacity" Value="0.8"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</Window>