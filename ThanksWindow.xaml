<Window x:Class="PixelStudio.ThanksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Thanks_Title}" Icon="pack://application:,,,/logo.ico" Width="520" Height="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme_WindowBg}" Foreground="#E6E6E6" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Thanks_Title}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="{loc:Loc Key=Thanks_Subtitle}" FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="20,16,20,0" Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="{DynamicResource Theme_TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,12,20,0">
            <StackPanel>
                <TextBlock x:Name="CountLabel" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" Margin="4,0,0,10"/>

                <!-- ★ 这里只保留这一个 ListPanel -->
                <WrapPanel x:Name="ListPanel" HorizontalAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Key=Thanks_Footer}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{loc:Loc Key=Common_Close}" Width="80" Height="32" Click="Close_Click"
                        Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>