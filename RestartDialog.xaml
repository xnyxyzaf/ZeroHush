<Window x:Class="PixelStudio.RestartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Restart_Title}" Icon="pack://application:,,,/logo.ico" Width="440" Height="230"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme_WindowBg}"
        Foreground="#E6E6E6" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">

    <Border Background="{DynamicResource Theme_WindowBg}" CornerRadius="12" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="{loc:Loc Key=Restart_Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,10">
                <TextBlock Text="{loc:Loc Key=Restart_Message}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" CornerRadius="0,0,12,12" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Key=Restart_Later}" Width="110" Height="34" Margin="0,0,8,0" Click="Later_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="{loc:Loc Key=Restart_Now}" Width="110" Height="34" Click="RestartNow_Click" Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>