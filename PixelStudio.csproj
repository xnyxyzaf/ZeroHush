<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<ApplicationIcon>logo.ico</ApplicationIcon>
	<SatelliteResourceLanguages>en-US;zh-CN</SatelliteResourceLanguages>  
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>ZeroHush</RootNamespace>
    <AssemblyName>ZeroHush</AssemblyName>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

	<!-- 编译后自动在输出目录创建 Languages 和 Themes 空文件夹 -->
	<Target Name="CreateDataFolders" AfterTargets="Build">
		<MakeDir Directories="$(OutDir)Languages;$(OutDir)Themes" />
	</Target>
	<ItemGroup>
	  <None Remove="logo.ico" />
	  <None Remove="ui_logo.png" />
	</ItemGroup>
	<ItemGroup>
	  <Resource Include="logo.ico" />
	  <Resource Include="ui_logo.png" />
	</ItemGroup>

</Project>