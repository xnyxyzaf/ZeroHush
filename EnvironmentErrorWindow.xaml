<Window x:Class="PixelStudio.EnvironmentErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Env_Title}" Icon="pack://application:,,,/logo.ico"
        
        Width="480" Height="300"
        WindowStartupLocation="CenterScreen"
Background="{DynamicResource Theme_WindowBg}"        Foreground="#E6E6E6"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{DynamicResource Theme_WindowBg}"
            CornerRadius="12"
            BorderBrush="#3A3A3A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme_PanelBg}"
                    CornerRadius="12,12,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠"
                               FontSize="18"
                               Foreground="#E9A23B"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{loc:Loc Key=Env_Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="30,10">
                <TextBlock x:Name="MessageText"
                           Foreground="#C8C8C8"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="24"/>

                <Border Background="#2A2A2A"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="VersionText"
                               Foreground="#9A9A9A"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- 按钮 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Theme_PanelBg}"
                    CornerRadius="0,0,12,12"
                    Padding="16,12">
                <Button Content="{loc:Loc Key=Common_OK}"
                        Width="120" Height="36"
                        HorizontalAlignment="Center"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#4A90E2" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand"
                        Click="Ok_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#5AA0F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>