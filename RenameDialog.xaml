<Window x:Class="PixelStudio.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Rename_Title}" Icon="pack://application:,,,/logo.ico" Width="360" Height="180"
        WindowStartupLocation="CenterOwner"
Background="{DynamicResource Theme_WindowBg}"        Foreground="#E6E6E6"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="20,14">
            <TextBlock Text="{loc:Loc Key=Rename_Title}" FontSize="16" FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,0">
            <TextBlock Text="{loc:Loc Key=Rename_Label}" Foreground="#9A9A9A"
                       FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox"
                     Background="#2E2E2E" Foreground="White"
                     BorderThickness="0" Padding="8,6"
                     FontSize="13"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Common_Cancel}" Width="80" Height="32" Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#3A3A3A" Foreground="White"
                        BorderThickness="0" FontSize="12"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#4A4A4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="{loc:Loc Key=Common_OK}" Width="80" Height="32"
                        Click="Ok_Click"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#4A90E2" Foreground="White"
                        BorderThickness="0" FontSize="12"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#5AA0F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>