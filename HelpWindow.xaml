<Window x:Class="PixelStudio.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Help_Title}" Icon="pack://application:,,,/logo.ico" Width="800" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme_WindowBg}" Foreground="#E6E6E6" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Help_Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="{loc:Loc Key=Help_Subtitle}" FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧列 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Key=Help_Group_Tools}" Foreground="{DynamicResource Theme_Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,0,0">
                                <TextBlock Text="{loc:Loc Key=Help_Pen}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Eraser}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Fill}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Picker}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Line}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Rect}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Ellipse}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <!-- ★ 加了 x:Name -->
                                <TextBlock x:Name="PenKeyText" Text="B" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="EraserKeyText" Text="E" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="FillKeyText" Text="G" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="PickerKeyText" Text="I" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="LineKeyText" Text="L" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="RectKeyText" Text="R" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="EllipseKeyText" Text="O" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc Key=Help_Group_Edit}" Foreground="{DynamicResource Theme_Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Key=Help_Undo}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Redo}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_SwapColors}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <!-- ★ 加了 x:Name -->
                                <TextBlock x:Name="UndoKeyText" Text="Ctrl+Z" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="RedoKeyText" Text="Ctrl+Y" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="SwapKeyText" Text="X" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 右侧列 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Loc Key=Help_Group_File}" Foreground="{DynamicResource Theme_Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Key=Help_New}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Open}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_Save}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_CloseDoc}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <!-- ★ 加了 x:Name -->
                                <TextBlock x:Name="NewKeyText" Text="Ctrl+N" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="OpenKeyText" Text="Ctrl+O" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="SaveKeyText" Text="Ctrl+S" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="CloseKeyText" Text="Ctrl+W" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc Key=Help_Group_View}" Foreground="{DynamicResource Theme_Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Key=Help_Zoom}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_ScrollH}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_BrushSizeAlt}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=Help_SwitchDoc}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <!-- ★ 加了 x:Name -->
                                <TextBlock x:Name="ZoomInKeyText" Text="Ctrl+滚轮" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock Text="Shift+滚轮" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock Text="Alt+滚轮" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <TextBlock x:Name="NextDocKeyText" Text="Ctrl+Tab" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc Key=Help_Group_Layer}" Foreground="{DynamicResource Theme_Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Help_LayerHint}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{loc:Loc Key=Help_LayerHint2}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,10,0,0"/>
                            <TextBlock Text="{loc:Loc Key=Help_LayerHint3}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
            <Button Content="{loc:Loc Key=Common_OK}" Width="120" Height="36" HorizontalAlignment="Center" Click="Ok_Click"
                    Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>