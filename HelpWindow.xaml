<Window x:Class="PixelStudio.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=Help_Title}" Icon="pack://application:,,,/logo.ico" Width="440" Height="620"
        WindowStartupLocation="CenterOwner"
Background="{DynamicResource Theme_WindowBg}"        Foreground="#E6E6E6"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Help_Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Text="{loc:Loc Key=Help_Subtitle}"
                           FontSize="11" Foreground="#9A9A9A"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <TextBlock Text="{loc:Loc Key=Help_Group_Tools}" Foreground="#4A90E2"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,10"/>
                <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=Help_Pen}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Eraser}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Fill}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Picker}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Line}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Rect}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Ellipse}" Foreground="#C8C8C8" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="B" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="E" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="G" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="I" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="L" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="R" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="O" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=Help_Group_Edit}" Foreground="#4A90E2"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,10"/>
                <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=Help_Undo}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Redo}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_SwapColors}" Foreground="#C8C8C8" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ctrl+Z" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Ctrl+Y" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="X" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=Help_Group_File}" Foreground="#4A90E2"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,10"/>
                <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=Help_New}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Open}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_Save}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_CloseDoc}" Foreground="#C8C8C8" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ctrl+N" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Ctrl+O" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Ctrl+S" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Ctrl+W" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=Help_Group_View}" Foreground="#4A90E2"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,10"/>
                <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=Help_Zoom}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_ScrollH}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_BrushSizeAlt}" Foreground="#C8C8C8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Key=Help_SwitchDoc}" Foreground="#C8C8C8" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ctrl+滚轮" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Shift+滚轮" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Alt+滚轮" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock Text="Ctrl+Tab" Foreground="#4A90E2" FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Key=Help_Group_Layer}" Foreground="#4A90E2"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,10"/>
                <Border Background="{DynamicResource Theme_PanelBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Help_LayerHint}" Foreground="#C8C8C8" FontSize="12"/>
                        <TextBlock Text="{loc:Loc Key=Help_LayerHint2}" Foreground="#C8C8C8" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="{loc:Loc Key=Help_LayerHint3}" Foreground="#C8C8C8" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
            <Button Content="{loc:Loc Key=Common_OK}"
                    Width="100" Height="32"
                    HorizontalAlignment="Center"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#4A90E2" Foreground="White"
                    BorderThickness="0" FontSize="12"
                    Cursor="Hand"
                    Click="Ok_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#5AA0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>