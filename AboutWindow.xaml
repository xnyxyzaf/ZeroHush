<Window x:Class="PixelStudio.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=About_Title}" Icon="pack://application:,,,/logo.ico" Width="420" Height="360"
        WindowStartupLocation="CenterOwner"
Background="{DynamicResource Theme_WindowBg}"        Foreground="#E6E6E6"
        ResizeMode="NoResize">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="20,14">
			<TextBlock Text="{loc:Loc Key=About_Title}" FontSize="16" FontWeight="SemiBold"
                       Foreground="White"/>
		</Border>

		<StackPanel Grid.Row="1" VerticalAlignment="Center"
                    HorizontalAlignment="Center">

			<Border Width="72" Height="72"
                    CornerRadius="16"
                    Background="#4A90E2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
				<TextBlock Text="Z"
                           Foreground="White"
                           FontSize="40"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
			</Border>

			<TextBlock Text="ZeroHush"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

			<TextBlock Text="{loc:Loc Key=About_Version}"
                       Foreground="#9A9A9A"
                       FontSize="12"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"/>

			<TextBlock Text="{loc:Loc Key=About_Tagline}"
                       Foreground="#9A9A9A"
                       FontSize="12"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Center"/>

			<TextBlock Text="{loc:Loc Key=About_BuiltWith}"
                       Foreground="#7A7A7A"
                       FontSize="11"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"/>

			<TextBlock Text="{loc:Loc Key=About_Studio}"
                       Foreground="#6E6E6E"
                       FontSize="11"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"/>
		</StackPanel>

		<Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
			<Button Content="{loc:Loc Key=Common_OK}"
                    Width="100" Height="32"
                    HorizontalAlignment="Center"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#4A90E2" Foreground="White"
                    BorderThickness="0" FontSize="12"
                    Cursor="Hand"
                    Click="Ok_Click">
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bg" Property="Background" Value="#5AA0F2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Button.Template>
			</Button>
		</Border>
	</Grid>
</Window>