<Window x:Class="PixelStudio.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=About_Title}" Icon="pack://application:,,,/logo.ico" Width="400" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme_WindowBg}" Foreground="#E6E6E6"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">

    <Border Background="{DynamicResource Theme_WindowBg}" CornerRadius="12" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="{loc:Loc Key=About_Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <Border Width="100" Height="100" CornerRadius="18" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="ui_logo.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="ZeroHush" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Key=About_Version}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Key=About_Tagline}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Key=About_BuiltWith}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Key=About_Studio}" Foreground="{DynamicResource Theme_TextDim}" FontSize="11" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" CornerRadius="0,0,12,12" Padding="16,12">
                <Button Content="{loc:Loc Key=Common_OK}" Width="100" Height="32" HorizontalAlignment="Center" Click="Ok_Click"
                        Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>