<Window x:Class="PixelStudio.NewCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="{loc:Loc Key=NewCanvas_Title}" Icon="pack://application:,,,/logo.ico" Width="620" Height="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme_WindowBg}" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="BgChoiceStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="12,6" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme_Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme_Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" Padding="20,14">
            <TextBlock Text="{loc:Loc Key=NewCanvas_Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Theme_WindowBg}" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="PreviewArea" Grid.Row="0" ClipToBounds="False">
                        <Border x:Name="PreviewBox" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" CornerRadius="2" Background="Transparent"/>
                    </Grid>

                    <TextBlock x:Name="PreviewSizeLabel" Grid.Row="1" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" Text="64 × 64"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=NewCanvas_PresetRatio}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="1:1"  Tag="1:1"  Style="{StaticResource PresetButtonStyle}" Click="Preset_Click"/>
                        <Button Content="4:3"  Tag="4:3"  Style="{StaticResource PresetButtonStyle}" Click="Preset_Click"/>
                        <Button Content="3:2"  Tag="3:2"  Style="{StaticResource PresetButtonStyle}" Click="Preset_Click"/>
                        <Button Content="16:9" Tag="16:9" Style="{StaticResource PresetButtonStyle}" Click="Preset_Click"/>
                        <Button Content="2:1"  Tag="2:1"  Style="{StaticResource PresetButtonStyle}" Click="Preset_Click"/>
                        <Button Content="1:2"  Tag="1:2"  Style="{StaticResource PresetButtonStyle}" Click="Preset_Click"/>
                    </WrapPanel>

                    <TextBlock Text="{loc:Loc Key=NewCanvas_Width}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,12,0,4"/>
                    <TextBox x:Name="WidthBox" Text="64" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="8,6" FontFamily="Consolas" FontSize="13" TextChanged="SizeBox_TextChanged"/>

                    <TextBlock Text="{loc:Loc Key=NewCanvas_Height}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,12,0,4"/>
                    <TextBox x:Name="HeightBox" Text="64" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" Padding="8,6" FontFamily="Consolas" FontSize="13" TextChanged="SizeBox_TextChanged"/>

                    <TextBlock Text="{loc:Loc Key=NewCanvas_CommonSizes}" Foreground="{DynamicResource Theme_TextDim}" FontSize="11" Margin="0,8,0,0"/>

                    <TextBlock Text="{loc:Loc Key=NewCanvas_BackgroundColor}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Margin="0,18,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BgTransparentRadio" Content="{loc:Loc Key=NewCanvas_BgTransparent}" GroupName="BgColor" Style="{StaticResource BgChoiceStyle}" IsChecked="True" Checked="BgRadio_Changed"/>
                        <RadioButton x:Name="BgWhiteRadio" Content="{loc:Loc Key=NewCanvas_BgWhite}" GroupName="BgColor" Style="{StaticResource BgChoiceStyle}" Checked="BgRadio_Changed"/>
                        <RadioButton x:Name="BgBlackRadio" Content="{loc:Loc Key=NewCanvas_BgBlack}" GroupName="BgColor" Style="{StaticResource BgChoiceStyle}" Checked="BgRadio_Changed"/>
                        <RadioButton x:Name="BgCustomRadio" GroupName="BgColor" Style="{StaticResource BgChoiceStyle}" Checked="BgRadio_Changed">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CustomColorChip" Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Theme_Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=NewCanvas_BgCustom}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Button x:Name="PickCustomColorButton" Content="{loc:Loc Key=NewCanvas_PickCustomColor}" Width="160" Height="30" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand" Visibility="Collapsed" Click="PickCustomColor_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Theme_PanelBg}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Common_Cancel}" Width="80" Height="32" Margin="0,0,8,0" Click="Cancel_Click" Background="{DynamicResource Theme_Border}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="{loc:Loc Key=Common_OK}" Width="80" Height="32" Click="Ok_Click" Background="{DynamicResource Theme_Accent}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>