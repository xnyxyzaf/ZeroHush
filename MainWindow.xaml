<Window x:Class="PixelStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelStudio"
        Title="ZeroHush" Icon="pack://application:,,,/logo.ico" Height="760" Width="1280"
        Background="{DynamicResource Theme_WindowBg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Theme_WindowBg}"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <Border x:Name="hoverBar"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                <Setter TargetName="hoverBar" Property="Background" Value="{DynamicResource Theme_Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                <Setter TargetName="hoverBar" Property="Background" Value="{DynamicResource Theme_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Theme_WindowBg}"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <Border x:Name="hoverBar"
                                    Width="2"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                <Setter TargetName="hoverBar" Property="Background" Value="{DynamicResource Theme_Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                <Setter TargetName="hoverBar" Property="Background" Value="{DynamicResource Theme_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme_Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Theme_TextDim}"/>
                                <Setter TargetName="bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource Theme_Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Theme_WindowBg_Semi}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 菜单 ========== -->
        <Menu Grid.Row="0" Background="{DynamicResource Theme_PanelBg}" HorizontalAlignment="Left">
            <MenuItem Header="{loc:Loc Key=Menu_File}" Foreground="White">
                <MenuItem x:Name="FileNewMenuItem" Header="{loc:Loc Key=File_New}" Click="New_Click"/>
                <MenuItem Header="{loc:Loc Key=File_Open}" InputGestureText="Ctrl+O" Click="Open_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Key=File_Save}" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="{loc:Loc Key=File_SaveAs}" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Key=File_CloseDoc}" InputGestureText="Ctrl+W" Click="CloseDocument_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Key=File_Exit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Menu_Edit}" Foreground="White">
                <MenuItem x:Name="UndoMenuItem" Header="{loc:Loc Key=Edit_Undo}" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem x:Name="RedoMenuItem" Header="{loc:Loc Key=Edit_Redo}" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Key=Edit_ClearLayer}" Click="ClearLayer_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Menu_Image}" Foreground="White">
                <MenuItem Header="{loc:Loc Key=Image_CanvasSize}" Click="CanvasSize_Click"/>
                <MenuItem Header="{loc:Loc Key=Image_FlipH}" Click="FlipH_Click"/>
                <MenuItem Header="{loc:Loc Key=Image_FlipV}" Click="FlipV_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Menu_Layer}" Foreground="White">
                <MenuItem Header="{loc:Loc Key=Layer_New}" InputGestureText="Ctrl+Shift+N" Click="AddLayer_Click"/>
                <MenuItem Header="{loc:Loc Key=Layer_NewFolder}" Click="AddFolder_Click"/>
                <MenuItem Header="{loc:Loc Key=Layer_Delete}" Click="RemoveLayer_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Key=Layer_MoveUp}" Click="MoveLayerUp_Click"/>
                <MenuItem Header="{loc:Loc Key=Layer_MoveDown}" Click="MoveLayerDown_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Menu_View}" Foreground="White">
                <MenuItem Header="{loc:Loc Key=View_ZoomIn}" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="{loc:Loc Key=View_ZoomOut}" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="{loc:Loc Key=View_ZoomReset}" InputGestureText="Ctrl+0" Click="ZoomReset_Click"/>
                <Separator/>
                <MenuItem x:Name="GridMenuItem" Header="{loc:Loc Key=View_ShowGrid}" IsCheckable="True" IsChecked="True" Click="ToggleGrid_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Menu_Window}" Foreground="White">
                <MenuItem Header="{loc:Loc Key=Window_SwapColors}" InputGestureText="X" Click="SwapColors_Click"/>
                <MenuItem Header="{loc:Loc Key=Window_NextDoc}" InputGestureText="Ctrl+Tab" Click="NextDoc_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="{loc:Loc Key=Menu_Help}" Foreground="White">
                <MenuItem Header="{loc:Loc Key=Help_Shortcuts}" Click="ShowHelp_Click"/>
                <MenuItem Header="{loc:Loc Key=Help_About}" Click="ShowAbout_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Menu_Settings}" Foreground="White" Click="Settings_Click"/>
        </Menu>

        <!-- ========== 工具选项栏 ========== -->
        <Border Grid.Row="1" Background="{DynamicResource Theme_PanelBg_Semi}" Height="36" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToolNameLabel" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,20,0" Text="{loc:Loc Key=Tool_Pen}"/>

                <TextBlock Text="{loc:Loc Key=Toolbar_BrushSize}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="ToolBarBrushSize" Minimum="1" Maximum="20" Value="1"
                        Width="120" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="ToolBarBrushSize_Changed"/>
                <TextBlock x:Name="ToolBarBrushSizeLabel" Text="1" Foreground="White" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,20,0" MinWidth="20"/>

                <TextBlock Text="{loc:Loc Key=Toolbar_Opacity}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                        Width="120" VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_Changed"/>
                <TextBlock x:Name="OpacityLabel" Text="100%" Foreground="White" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,20,0" MinWidth="40"/>

                <TextBlock Text="{loc:Loc Key=Toolbar_Mirror}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="MirrorCombo" Width="90" VerticalAlignment="Center"
                          Background="{DynamicResource Theme_CardBg}" Foreground="White" BorderThickness="0" Padding="6,4"
                          SelectionChanged="MirrorCombo_Changed">
                    <ComboBoxItem Content="{loc:Loc Key=Mirror_Off}" Tag="None" IsSelected="True"/>
                    <ComboBoxItem Content="{loc:Loc Key=Mirror_Horizontal}" Tag="Horizontal"/>
                    <ComboBoxItem Content="{loc:Loc Key=Mirror_Vertical}" Tag="Vertical"/>
                    <ComboBoxItem Content="{loc:Loc Key=Mirror_Quadrant}" Tag="Quadrant"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ========== 文档标签 ========== -->
        <TabControl x:Name="DocumentTabs" Grid.Row="2"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Left"
                    SelectionChanged="DocumentTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Theme_TextSecondary}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bg" Background="{DynamicResource Theme_PanelBg}"
                                        CornerRadius="6,6,0,0"
                                        Padding="12,6" Margin="0,0,2,0"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="False"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"/>

                                        <Button x:Name="CloseTabBtn"
                                                Grid.Column="1"
                                                Content="✕"
                                                Width="16" Height="16" Padding="0"
                                                Margin="8,0,0,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource Theme_TextSecondary}" FontSize="10"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="CloseTab_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="cbtn" Background="Transparent" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="cbtn" Property="Background" Value="#E81123"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_WindowBg}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme_HoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
        </TabControl>

        <!-- ========== 主体 ========== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="360" MinWidth="260" MaxWidth="700"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Theme_PanelBg_Semi}" Padding="8">
                <StackPanel>
                    <RadioButton x:Name="PenTool" Content="✏️" GroupName="Tool" IsChecked="True"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="画笔 (B)"
                                 Click="Tool_Changed" Tag="Pen"/>
                    <RadioButton x:Name="EraserTool" Content="🧽" GroupName="Tool"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="橡皮 (E)"
                                 Click="Tool_Changed" Tag="Eraser"/>
                    <RadioButton x:Name="FillTool" Content="🪣" GroupName="Tool"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="油漆桶 (G)"
                                 Click="Tool_Changed" Tag="Fill"/>
                    <RadioButton x:Name="PickerTool" Content="💧" GroupName="Tool"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="吸管 (I)"
                                 Click="Tool_Changed" Tag="Picker"/>
                    <RadioButton x:Name="LineTool" Content="📏" GroupName="Tool"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="直线 (L)"
                                 Click="Tool_Changed" Tag="Line"/>
                    <RadioButton x:Name="RectTool" Content="▭" GroupName="Tool"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="矩形 (R)"
                                 Click="Tool_Changed" Tag="Rect"/>
                    <RadioButton x:Name="EllipseTool" Content="◯" GroupName="Tool"
                                 Style="{StaticResource ToolButtonStyle}" ToolTip="椭圆 (O)"
                                 Click="Tool_Changed" Tag="Ellipse"/>
                </StackPanel>
            </Border>

            <!-- ★ 关键修复：画布外围背景、棋盘格颜色 -->
            <ScrollViewer Grid.Column="1" x:Name="CanvasScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Theme_CanvasBg}"
                          PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Theme_PanelBg}" Padding="20" CornerRadius="8">
                        <Border Padding="0" CornerRadius="4" ClipToBounds="True">
                            <Border.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <!-- 棋盘格：改为动态跟随主题 -->
                                            <GeometryDrawing Brush="{DynamicResource Theme_Border}">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,16,16"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="{DynamicResource Theme_WindowBg}">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                        <RectangleGeometry Rect="8,8,8,8"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>

                            <Grid>
                                <Image x:Name="CanvasImage"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True"
                                       MouseLeftButtonDown="Canvas_MouseDown"
                                       MouseRightButtonDown="Canvas_MouseDown"
                                       MouseLeftButtonUp="Canvas_MouseUp"
                                       MouseRightButtonUp="Canvas_MouseUp"
                                       MouseMove="Canvas_MouseMove"
                                       MouseLeave="Canvas_MouseLeave"
                                       LostMouseCapture="CanvasImage_LostMouseCapture"/>
                                <Border x:Name="GridOverlay" IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <Grid x:Name="BrushCursor"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed">
                                    <Ellipse Stroke="#80000000" StrokeThickness="3"/>
                                    <Ellipse Stroke="White" StrokeThickness="1"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Column="2"
                          Style="{StaticResource VerticalSplitterStyle}"/>

            <Border Grid.Column="3" Background="{DynamicResource Theme_PanelBg_Semi}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="700">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="200"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="3*" MinHeight="150"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Panel_Color}" Style="{StaticResource SectionTitle}"/>
                                <Grid Height="70">
                                    <Border x:Name="BgColorSwatch"
                                            Width="50" Height="50" CornerRadius="6"
                                            Background="White"
                                            BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="BgColor_Click"
                                            ToolTip="背景色"/>
                                    <Border x:Name="CurrentColorPreview"
                                            Width="50" Height="50" CornerRadius="6"
                                            Background="Black"
                                            BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="CurrentColor_Click"
                                            ToolTip="前景色"/>
                                    <Button Content="⇄" Width="22" Height="22"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Theme_TextSecondary}" FontSize="12" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Click="SwapColors_Click"
                                            ToolTip="互换 (X)"/>
                                </Grid>
                                <TextBox x:Name="HexColorBox"
                                         Background="{DynamicResource Theme_CardBg}" Foreground="White"
                                         BorderThickness="0" Padding="6,4" FontFamily="Consolas"
                                         FontSize="11" Margin="0,8,0,0"
                                         Text="#FF000000"
                                         TextChanged="HexColorBox_TextChanged"/>
                                <Button Content="{loc:Loc Key=Panel_OpenColorPicker}"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Margin="0,8,0,0"
                                        Click="PickColor_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Panel_Palette}" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel x:Name="PalettePanel"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Key=Panel_Layers}" Style="{StaticResource SectionTitle}" Margin="0,0,0,0"/>
                                    <TextBlock Text="{loc:Loc Key=Panel_DragSort}"
                                               FontSize="10" Foreground="{DynamicResource Theme_TextDim}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <TreeView x:Name="LayerTree"
                                              Background="{DynamicResource Theme_CardBg}" BorderThickness="0"
                                              SelectedItemChanged="LayerTree_SelectedItemChanged"
                                              MouseDoubleClick="LayerTree_MouseDoubleClick"
                                              PreviewMouseLeftButtonDown="LayerTree_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="LayerTree_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="LayerTree_PreviewMouseLeftButtonUp"
                                              LostMouseCapture="LayerTree_LostMouseCapture"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <TreeView.Resources>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="1,3"/>
                                            </Style>
                                        </TreeView.Resources>
                                    </TreeView>

                                    <Border x:Name="DropLine"
                                            Height="2"
                                            Background="{DynamicResource Theme_Accent}"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"/>

                                    <Border x:Name="DropHighlight"
                                            BorderBrush="{DynamicResource Theme_Accent}"
                                            BorderThickness="2"
                                            CornerRadius="3"
                                            Background="{DynamicResource Theme_HoverBg}"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{loc:Loc Key=LayerBtn_Add}" Padding="8,4"
                                            Click="AddLayer_Click"
                                            Style="{StaticResource SmallButtonStyle}"/>
                                    <Button Content="{loc:Loc Key=LayerBtn_AddFolder}" Padding="8,4" Margin="6,0,0,0"
                                            Click="AddFolder_Click"
                                            Style="{StaticResource SmallButtonStyle}"/>
                                    <Button Content="−" Width="30" Height="26" Margin="6,0,0,0"
                                            Click="RemoveLayer_Click"
                                            Style="{StaticResource SmallButtonStyle}"/>
                                    <Button Content="↑" Width="30" Height="26" Margin="6,0,0,0"
                                            Click="MoveLayerUp_Click"
                                            Style="{StaticResource SmallButtonStyle}"/>
                                    <Button Content="↓" Width="30" Height="26" Margin="6,0,0,0"
                                            Click="MoveLayerDown_Click"
                                            Style="{StaticResource SmallButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="3"
                                      Style="{StaticResource HorizontalSplitterStyle}"
                                      Margin="0,0,0,6"/>

                        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Loc Key=Panel_History}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,6"/>
                                <ListBox x:Name="HistoryList"
                                         Grid.Row="1"
                                         Background="{DynamicResource Theme_CardBg}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="HistoryList_SelectionChanged"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========== 状态栏 ========== -->
        <Border Grid.Row="4" Background="{DynamicResource Theme_PanelBg}" Height="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Foreground="{DynamicResource Theme_TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="{loc:Loc Key=Status_Ready}"/>
                <TextBlock x:Name="DocInfoLabel" Grid.Column="1" Foreground="{DynamicResource Theme_TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" Text=""/>
                <TextBlock x:Name="MemoryLabel" Grid.Column="2" Foreground="{DynamicResource Theme_TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" Text=""/>
                <TextBlock x:Name="ZoomLabel" Grid.Column="3" Foreground="{DynamicResource Theme_TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="100%"/>
            </Grid>
        </Border>
    </Grid>
</Window>